{
  "name": "my-3dvge",
  "version": "0.0.0",
  "private": true,
  "description": "Physics-first destructible voxel engine for the browser (three.js WebGPU + Rapier).",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
